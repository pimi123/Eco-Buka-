APP_NAME="Eco Buka CMS"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
FRONTEND_URL=http://127.0.0.1:5173

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_TIMEZONE=Europe/Tirane

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=eco_buka
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

NESTPAY_ENVIRONMENT=local
NESTPAY_3D_GATEWAY_URL=https://torus-stage-tebkosova.asseco-see.com.tr/fim/est3dgate
NESTPAY_API_URL=https://torus-stage-tebkosova.asseco-see.com.tr/fim/api
NESTPAY_CLIENT_ID=your_nestpay_client_id
NESTPAY_STORE_KEY=
NESTPAY_STORE_TYPE=3d_pay_hosting
NESTPAY_TRANSACTION_TYPE=Auth
NESTPAY_CURRENCY=978
NESTPAY_LANGUAGE=en
NESTPAY_HASH_ALGORITHM=ver3
NESTPAY_REFRESH_TIME=5
NESTPAY_INSTALLMENTS_ENABLED=false
NESTPAY_ALLOWED_INSTALLMENTS=
NESTPAY_MIN_INSTALLMENT_AMOUNT=0
NESTPAY_INSTALLMENT_PARAMETER=Instalment
NESTPAY_OK_URL=https://dev.ecoflowks.com/api/nestpay-test/success
NESTPAY_FAIL_URL=https://dev.ecoflowks.com/api/nestpay-test/failure
NESTPAY_SHOP_URL=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Optional local override if Windows/OneDrive blocks Laravel compiled Blade views.
# VIEW_COMPILED_PATH=/tmp/eco-buka-laravel-views
